<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="urusi_emacs.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:urusi_emacs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="urusi-emacs">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The UI sent by Emacs. Above the editor, because a window of
             its own is always drawn over anything XAML puts there. -->
        <Grid x:Name="Surface" Grid.Row="0" />

        <!-- Where the Emacs frame goes. It is a window of Emacs's own,
             placed over this one and kept the same size, so nothing is
             drawn here. -->
        <Border x:Name="EditorSite" Grid.Row="1" />

        <!-- What Emacs writes to its standard output and error, until
             it has a frame to show instead. -->
        <ScrollViewer x:Name="LogView" Grid.Row="1" Padding="16">
            <TextBlock
                x:Name="Log"
                FontFamily="Consolas"
                FontSize="12"
                IsTextSelectionEnabled="True"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </ScrollViewer>

        <!-- Shown while waiting for Emacs, and for errors. -->
        <TextBlock
            x:Name="Status"
            Grid.Row="1"
            Margin="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Opacity="0.6"
            TextWrapping="Wrap" />
    </Grid>
</Window>
