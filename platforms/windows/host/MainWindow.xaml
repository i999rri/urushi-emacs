<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="urushi_emacs.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:urushi_emacs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="urushi-emacs">

    <!-- A background of its own, or the window is not painted at all
         where the screen does not reach, and XAML leaves what it did
         not paint clear: an unpainted window is a black one. -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- What Emacs writes to its standard output and error, until
             there is a screen to show instead. -->
        <ScrollViewer x:Name="LogView" Padding="16">
            <TextBlock
                x:Name="Log"
                FontFamily="Consolas"
                FontSize="12"
                IsTextSelectionEnabled="True"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </ScrollViewer>

        <!-- The size of the Emacs frame, which decides how much text
             Emacs lays out. The frame itself is elsewhere, in a window
             that is never shown; what is seen here is built in Lisp
             from what Emacs decided to display. -->
        <Border x:Name="EditorSite" />

        <!-- The screen, as Emacs Lisp built it. -->
        <Grid x:Name="Surface" />

        <!-- Something has to hold the focus for the keys and the input
             method to have somewhere to arrive. It is not a Button:
             a button would answer the space bar itself. -->
        <ContentControl
            x:Name="InputSink"
            IsTabStop="True"
            Width="1"
            Height="1"
            Opacity="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />

        <!-- Shown while waiting for Emacs, and for errors. -->
        <TextBlock
            x:Name="Status"
            Margin="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Opacity="0.6"
            TextWrapping="Wrap" />
    </Grid>
</Window>
